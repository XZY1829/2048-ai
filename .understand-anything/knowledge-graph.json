  "project": {
    "name": "2048-cpp",
    "languages": ["C++"],
    "frameworks": ["CMake", "MSYS2/GCC"],
    "description": "纯 C++ 实现的 2048 游戏 + Expectimax AI 冲分引擎。采用 64 位 Bitboard 棋盘编码 + 65536 项预计算查找表实现极致性能，AI 通过 Expectimax 博弈树搜索自动冲分。",
    "analyzedAt": "2026-07-07T15:10:00+08:00",
    "gitCommitHash": "82a7f7d950457fe6b709ea876a6fd0e728bb89c2"
  },
